FROM node:22-bookworm-slim

WORKDIR /app

# Dependency diinstal lewat volume terpisah (lihat docker-compose.yml) supaya
# native binding cocok dengan Linux container, terlepas dari isi node_modules
# di host Windows.
COPY package.json ./
RUN npm install

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
