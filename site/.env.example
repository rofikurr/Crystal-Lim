# Salin file ini jadi .env lalu isi nilainya. Jangan commit file .env ke git.

# --- MySQL (dipakai container `mysql` & `app`) ---
MYSQL_ROOT_PASSWORD=ganti_root_password
MYSQL_DATABASE=crystal_lim
MYSQL_USER=crystal_lim
MYSQL_PASSWORD=ganti_password

# Di dalam Docker, host database pakai nama service `mysql`, bukan `localhost`.
DATABASE_URL=mysql://crystal_lim:ganti_password@mysql:3306/crystal_lim

# --- Sesi login admin ---
# String acak panjang, mis. hasil `openssl rand -hex 32`.
SESSION_SECRET=ganti_dengan_string_acak_panjang

# --- Storage foto produk (lokal, bukan Cloudflare R2 lagi) ---
UPLOAD_DIR=./storage/uploads

# --- Akun superadmin awal (dibuat sekali oleh `npm run db:seed`) ---
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ganti_password_superadmin

# --- Xendit (payment gateway) ---
# Dashboard Xendit > Settings > API Keys (pakai mode Test dulu sebelum live)
XENDIT_SECRET_KEY=xnd_development_ganti_dengan_secret_key_asli
# Dashboard Xendit > Settings > Webhooks > Verification Token
XENDIT_CALLBACK_TOKEN=ganti_dengan_verification_token_asli

# Jangan set NODE_ENV di sini — Next.js otomatis memakai "development" untuk
# `next dev` dan "production" untuk `next build`/`next start`. Menimpanya lewat
# .env bisa merusak proses build (lihat peringatan Next.js soal ini).
